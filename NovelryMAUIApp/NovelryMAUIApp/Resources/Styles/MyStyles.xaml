<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
>
  <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

  <!--#region Colors-->
  <Color x:Key="Primary">#2973C7</Color>
  <Color x:Key="Green">#16A34A</Color>
  <Color x:Key="Orange">#EB6B2D</Color>
  <Color x:Key="Gold">#D9A33F</Color>
  <Color x:Key="Red">#D90202</Color>
  <Color x:Key="White">#F3F4F6</Color>
  <Color x:Key="BorderGrey">#323743</Color>
  <Color x:Key="DarkGrey">#1E2128</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
  <!--#endregion-->

  <!--#region Styles-->
  <!--#region  Entry-->
  <Style x:Key="EntryStyle" TargetType="Entry">
    <Setter
      Property="Background"
      Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkGrey}}"
    />
    <Setter Property="HorizontalTextAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="HorizontalOptions" Value="Fill" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="VerticalOptions" Value="Center" />
    <Setter
      Property="TextColor"
      Value="{AppThemeBinding Light={StaticResource DarkGrey}, Dark={StaticResource White}}"
    />
  </Style>
  <!--#endregion-->

  <!--#region Label-->
  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter
      Property="TextColor"
      Value="{AppThemeBinding Light={StaticResource DarkGrey}, Dark={StaticResource White}}"
    />
  </Style>
  <!--#endregion-->

  <!--#region Button-->
  <Style TargetType="Button">
    <Setter Property="Margin" Value="30,10" />
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="HeightRequest" Value="56" />
    <Setter
      Property="TextColor"
      Value="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
    />
    <Setter Property="WidthRequest" Value="300" />
  </Style>
  <!--#endregion-->

  <!--#region Icon-->
  <Style x:Key="Icon" TargetType="mi:MauiIcon">
    <Setter Property="HorizontalOptions" Value="Center" />
    <Setter Property="VerticalOptions" Value="Center" />
    <Setter Property="Scale" Value=".75" />
    <Setter
      Property="IconColor"
      Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
    />
  </Style>
  <!--#endregion-->

  <!--#region Border-->
  <Style TargetType="Border">
    <Setter Property="StrokeShape" Value="RoundRectangle 10,10,10,10" />
    <Setter Property="Stroke" Value="{StaticResource Gray950}" />
    <Setter Property="BackgroundColor" Value="{StaticResource Gray950}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <!--#endregion-->

  <!--#region Page-->
  <Style ApplyToDerivedTypes="True" TargetType="Page">
    <Setter Property="Padding" Value="0" />
    <Setter
      Property="BackgroundColor"
      Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
    />
  </Style>
  <!-- #endregion-->

  <!--#endregion-->
</ResourceDictionary>
