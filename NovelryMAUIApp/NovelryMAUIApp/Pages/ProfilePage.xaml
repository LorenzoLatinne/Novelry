<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="NovelryMAUIApp.Pages.ProfilePage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
  xmlns:vm="clr-namespace:NovelryMAUIApp.ViewModels"
  xmlns:model="clr-namespace:NovelryDTO.DTOs.User;assembly=NovelryDTO"
  x:DataType="vm:ProfileViewModel"
  Shell.FlyoutBehavior="Disabled"
  Shell.NavBarIsVisible="False"
>
  <ScrollView>
    <VerticalStackLayout Spacing="5">
      <!--  region Title  -->
      <Label
        FontAttributes="Bold"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="26"
        HorizontalTextAlignment="Center"
        Text="Profile"
        VerticalOptions="Center"
      />
      <!--#endregion-->

      <!--  region  Top line  -->
      <Line Stroke="{StaticResource Gray900}" StrokeThickness="3" X2="500" />
      <!--#endregion-->

      <!--#region Profile picture, username and bio-->
      <VerticalStackLayout Margin="25,0" HorizontalOptions="Center">
        <Border
          Margin="0,10,0,15"
          Background="Transparent"
          HeightRequest="96"
          StrokeShape="RoundRectangle 48"
          StrokeThickness="2"
          WidthRequest="96"
        >
          <Image Source="{Binding User.ImageUrl}" />
        </Border>
        <Label
          Margin="0,0,0,15"
          FontFamily="{DynamicResource AppFontFamily}"
          FontSize="24"
          HorizontalTextAlignment="Center"
          Text="{Binding User.Username}"
          TextColor="{StaticResource White}"
        />
      </VerticalStackLayout>
      <!--#endregion-->

      <!--TODO: Work on Annual Reading Challenge -->
      <!--#region Annual Reading Challenge-->
