      <!--#endregion-->

      <!--#region Earned Badges-->
      <VerticalStackLayout>
        <Label
          Margin="25,10"
          FontFamily="{DynamicResource AppFontFamily}"
          FontSize="20"
          Text="Earned Badges"
        />

        <FlexLayout Margin="25,0" Direction="Row" Wrap="Wrap">
          <CollectionView ItemsSource="{Binding Achievements}">
            <CollectionView.ItemTemplate>
              <DataTemplate x:DataType="achievementdto:UserAchievementDetailDto">
                <Border
                  Margin="5,5"
                  HeightRequest="200"
                  VerticalOptions="Center"
                  WidthRequest="160"
                >
                  <Grid
                    Background="{StaticResource Gray950}"
                    HorizontalOptions="Center"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="5"
                    VerticalOptions="Center"
                  >
                    <mi:MauiIcon
                      Grid.Row="0"
                      Icon="{mi:FontAwesomeSolid Icon=Trophy}"
                      IconColor="{DynamicResource Primary}"
                      IconSize="60"
                      Style="{StaticResource Icon}"
                    />
                    <Label
                      Grid.Row="1"
                      FontFamily="{DynamicResource AppFontFamily}"
                      FontSize="16"
                      HorizontalTextAlignment="Center"
                      Text="{Binding Achievement.Name}"
                    />
                    <Label
                      Grid.Row="2"
                      FontSize="14"
                      HorizontalTextAlignment="Center"
                      MaxLines="2"
                      Text="{Binding Achievement.Description}"
                    />
                    <Label
                      Grid.Row="3"
                      FontSize="12"
                      HorizontalTextAlignment="Center"
                      Text="Earned:"
                      TextColor="{StaticResource Gray500}"
                    />
                    <Label
                      Grid.Row="4"
                      FontSize="12"
                      HorizontalTextAlignment="Center"
                      Text="{Binding AchievedAt, Converter={StaticResource DateTimeToDateConverter}}"
                      TextColor="{StaticResource Gray500}"
                    />
                  </Grid>
                </Border>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </FlexLayout>
      </VerticalStackLayout>
      <!--#endregion-->

      <!--#region Future Milestones-->
      <VerticalStackLayout>
        <Label
          Margin="25,10"
          FontFamily="{DynamicResource AppFontFamily}"
          FontSize="20"
          Text="Future Milestones"
        />

        <FlexLayout Margin="25,0" Direction="Row" Wrap="Wrap">
          <Border Margin="5,5" HeightRequest="200" VerticalOptions="Center" WidthRequest="160">
            <Grid
              Background="{StaticResource Gray950}"
              HorizontalOptions="Center"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="5"
              VerticalOptions="Center"
            >
              <mi:MauiIcon
                Grid.Row="0"
                Icon="{mi:FontAwesomeSolid Icon=Lightbulb}"
                IconColor="{StaticResource Gold}"
                IconSize="60"
                Style="{StaticResource Icon}"
              />
              <Label
                Grid.Row="1"
                FontFamily="{DynamicResource AppFontFamily}"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Text="Wisdom Seeker"
              />
              <Label
                Grid.Row="2"
                FontSize="14"
                HorizontalTextAlignment="Center"
                MaxLines="2"
                Text="Read 5 non-fiction books"
              />
              <ProgressBar
                Grid.Row="3"
                Margin="20,0"
                Progress=".6"
                ProgressColor="{StaticResource Gold}"
              />
              <Label
                Grid.Row="4"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Text="60% Progress"
                TextColor="{StaticResource Gray500}"
              />
            </Grid>
          </Border>

          <Border Margin="5,5" HeightRequest="200" VerticalOptions="Center" WidthRequest="160">
            <Grid
              Background="{StaticResource Gray950}"
              HorizontalOptions="Center"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="5"
              VerticalOptions="Center"
            >
              <mi:MauiIcon
                Grid.Row="0"
                Icon="{mi:FontAwesomeSolid Icon=GraduationCap}"
                IconColor="{StaticResource Gold}"
                IconSize="60"
                Style="{StaticResource Icon}"
              />
              <Label
                Grid.Row="1"
                FontFamily="{DynamicResource AppFontFamily}"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Text="Classic Scholar"
              />
              <Label
                Grid.Row="2"
                FontSize="14"
                HorizontalTextAlignment="Center"
                MaxLines="2"
                Text="Dive into 3 literary classics."
              />
              <ProgressBar
                Grid.Row="3"
                Margin="20,0"
                Progress=".33"
                ProgressColor="{StaticResource Gold}"
              />
              <Label
                Grid.Row="4"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Text="33% Progress"
                TextColor="{StaticResource Gray500}"
              />
            </Grid>
          </Border>

          <Border Margin="5,5" HeightRequest="200" VerticalOptions="Center" WidthRequest="160">
            <Grid
              Background="{StaticResource Gray950}"
              HorizontalOptions="Center"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="5"
              VerticalOptions="Center"
            >
              <mi:MauiIcon
                Grid.Row="0"
                Icon="{mi:FontAwesomeSolid Icon=Compass}"
                IconColor="{StaticResource Gold}"
                IconSize="60"
                Style="{StaticResource Icon}"
              />
              <Label
                Grid.Row="1"
                FontFamily="{DynamicResource AppFontFamily}"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Text="Series Completionist"
              />
              <Label
                Grid.Row="2"
                FontSize="14"
                HorizontalTextAlignment="Center"
                MaxLines="2"
                Text="Finish a complete book series"
              />
              <ProgressBar
                Grid.Row="3"
                Margin="20,0"
                Progress=".0"
                ProgressColor="{StaticResource Gold}"
              />
              <Label
                Grid.Row="4"
                FontSize="12"
                HorizontalTextAlignment="Center"
                Text="0% Progress"
                TextColor="{StaticResource Gray500}"
              />
            </Grid>
          </Border>
        </FlexLayout>
      </VerticalStackLayout>
      <!--#endregion-->
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
