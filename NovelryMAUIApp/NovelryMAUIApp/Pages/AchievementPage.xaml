    <VerticalStackLayout Spacing="5">
      <!--  region Title  -->
      <Label
        FontAttributes="Bold"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="26"
        HorizontalOptions="Center"
        Text="Achievements"
        VerticalOptions="Center"
      >
        <Label.GestureRecognizers>
          <TapGestureRecognizer />
        </Label.GestureRecognizers>
      </Label>
      <!--#endregion-->

      <!--  region  Top line  -->
      <Line Stroke="{StaticResource Gray900}" StrokeThickness="3" X2="500" />
      <!--#endregion-->

      <!--TODO: Include App-wide challenge -->
