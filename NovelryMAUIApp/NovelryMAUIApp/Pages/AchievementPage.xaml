  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
  xmlns:models="clr-namespace:NovelryMAUIApp.ViewModels"
  xmlns:achievementdto="clr-namespace:NovelryDTO.DTOs.Achievement;assembly=NovelryDTO"
  xmlns:userdto="clr-namespace:NovelryDTO.DTOs.User;assembly=NovelryDTO"
  x:DataType="models:AchievementViewModel"
  Shell.FlyoutBehavior="Disabled"
  Shell.NavBarIsVisible="False"
>
