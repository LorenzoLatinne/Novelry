<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="NovelryMAUIApp.Pages.ExplorePage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
  xmlns:vm="clr-namespace:NovelryMAUIApp.ViewModels"
  xmlns:models="clr-namespace:NovelryDTO.DTOs.Book;assembly=NovelryDTO"
  xmlns:genres="clr-namespace:NovelryDTO.DTOs.Genre;assembly=NovelryDTO"
  x:DataType="vm:ExplorePageViewModel"
  Title=""
  Shell.NavBarIsVisible="False"
>
  <Grid RowDefinitions="Auto,*">
    <Border Margin="25,10" Grid.Row="0">
      <Grid ColumnDefinitions="Auto,*">
        <mi:MauiIcon
          Grid.Column="0"
          Icon="{mi:FontAwesomeSolid Icon=MagnifyingGlass}"
          Style="{StaticResource Icon}"
        />
        <Entry
          Grid.Column="1"
          Margin="10,0"
          Placeholder="Search books, authors..."
          Text="{Binding SearchText, Mode=TwoWay}"
          ClearButtonVisibility="WhileEditing"
        />
      </Grid>
    </Border>

    <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="10">
        <!-- Search Results -->
        <CollectionView
          ItemsSource="{Binding SearchResults}"
          IsVisible="{Binding IsSearching}"
          ItemSizingStrategy="MeasureFirstItem"
        >
          <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" />
          </CollectionView.ItemsLayout>
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:BookWithReviewDto">
              <Border
                Margin="0,5"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light=#f9f9f9, Dark=#1a1a1a}"
              >
                <Grid Padding="10" ColumnDefinitions="100,*">
                  <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                      Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExplorePageViewModel}}, Path=GoToBookDetailCommand}"
                      CommandParameter="{Binding Book.Id}"
                    />
                  </Grid.GestureRecognizers>
                  <Image
                    Grid.Column="0"
                    HeightRequest="120"
                    WidthRequest="100"
                    Aspect="AspectFill"
                    Source="{Binding Book.ImageUrl}"
                  />
                  <VerticalStackLayout Grid.Column="1" Padding="10,0">
                    <Label
                      Text="{Binding Book.Title}"
                      FontFamily="{DynamicResource AppFontFamily}"
                      FontSize="16"
                      LineBreakMode="WordWrap"
                    />
                    <Label
                      Text="{Binding Book.Authors, Converter={StaticResource BookAuthorsConverter}}"
                      FontFamily="Outfit"
                      FontSize="13"
                      TextColor="{AppThemeBinding Light=#555, Dark=#ccc}"
                    />
                    <HorizontalStackLayout
                      HorizontalOptions="Start"
                      VerticalOptions="Center"
                      Spacing="5"
                      Margin="0,10"
                    >
                      <mi:MauiIcon
                        Icon="{mi:FontAwesomeSolid Icon=Star}"
                        IconColor="{StaticResource Gold}"
                        IconSize="16"
                      />
                      <Label
                        Text="{Binding AverageRating}"
                        FontSize="12"
                        TextColor="{StaticResource Gold}"
                      />
                    </HorizontalStackLayout>
                  </VerticalStackLayout>
                </Grid>
              </Border>
            </DataTemplate>
          </CollectionView.ItemTemplate>

          <CollectionView.EmptyView>
            <StackLayout Padding="50" VerticalOptions="Center">
              <Label
                Text="No results found."
                FontFamily="{DynamicResource AppFontFamily}"
                FontSize="18"
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light=#555, Dark=#ccc}"
              />
            </StackLayout>
          </CollectionView.EmptyView>
        </CollectionView>

        <VerticalStackLayout IsVisible="{Binding IsSearching, Converter={StaticResource InverseBooleanConverter}}">
          <!-- Title -->
          <Label
            FontAttributes="Bold"
            FontFamily="{DynamicResource AppFontFamily}"
            FontSize="26"
            HorizontalOptions="Center"
            Text="Search &amp; Discover"
            VerticalOptions="Center"
          />

          <!-- Top line -->
          <Line Stroke="{StaticResource Gray900}" StrokeThickness="3" X2="500" />

          <!-- Categories -->
          <Label
            Margin="25,10"
            FontFamily="{DynamicResource AppFontFamily}"
            FontAttributes="Bold"
            FontSize="20"
            Text="Categories"
          />
          <VerticalStackLayout Margin="25,0">
            <CollectionView
              ItemsLayout="HorizontalList"
              SelectionMode="Single"
              ItemsSource="{Binding Genres}"
            >
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="genres:GenreDto">
                  <Border Margin="5,0" Padding="10" StrokeShape="RoundRectangle 15">
                    <HorizontalStackLayout
                      HorizontalOptions="Center"
                      Spacing="10"
                      VerticalOptions="Center"
                    >
                      <mi:MauiIcon
                        Icon="{mi:FontAwesomeSolid Icon=Tag}"
                        IconSize="20"
                        Style="{StaticResource Icon}"
                      />
                      <Label
                        Text="{Binding Name}"
                        FontFamily="{DynamicResource AppFontFamily}"
                        FontSize="14"
                        VerticalOptions="Center"
                      />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                      <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExplorePageViewModel}}, Path=FilterBooksByCategoryCommand}"
                        CommandParameter="{Binding .}"
                      />
                    </Border.GestureRecognizers>
                  </Border>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>

          <!-- Trending Books -->
          <Label
            Margin="25,10"
            FontFamily="{DynamicResource AppFontFamily}"
            FontAttributes="Bold"
            FontSize="20"
            Text="Trending Books"
          />
          <VerticalStackLayout Margin="25,0">
            <CollectionView
              ItemsSource="{Binding TrendingBooks}"
              ItemSizingStrategy="MeasureFirstItem"
            >
              <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" />
              </CollectionView.ItemsLayout>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BookWithReviewDto">
                  <Grid>
                    <Grid.GestureRecognizers>
                      <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExplorePageViewModel}}, Path=GoToBookDetailCommand}"
                        CommandParameter="{Binding Book.Id}"
                      />
                    </Grid.GestureRecognizers>
                    <Border Margin="5,0" WidthRequest="170">
                      <Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
                        <Image
                          Grid.Row="0"
                          Margin="0,0,0,10"
                          Aspect="AspectFit"
                          HeightRequest="150"
                          Source="{Binding Book.ImageUrl}"
                        />
                        <Label
                          Grid.Row="1"
                          Padding="5,0"
                          FontFamily="{DynamicResource AppFontFamily}"
                          FontSize="16"
                          LineBreakMode="WordWrap"
                          Text="{Binding Book.Title}"
                          VerticalTextAlignment="Center"
                        />
                        <Label
                          Grid.Row="2"
                          Padding="5,5"
                          FontFamily="Outfit"
                          Text="{Binding Book.Authors, Converter={StaticResource BookAuthorsConverter}}"
                          VerticalTextAlignment="Center"
                        />
                        <HorizontalStackLayout
                          Grid.Row="3"
                          Padding="5,0"
                          Spacing="5"
                          VerticalOptions="Center"
                        >
                          <mi:MauiIcon
                            Icon="{mi:FontAwesomeSolid Icon=Star}"
                            Scale=".5"
                            Style="{StaticResource Icon}"
                            IconColor="{StaticResource Gold}"
                          />
                          <Label
                            HorizontalTextAlignment="Center"
                            Text="{Binding AverageRating}"
                            VerticalTextAlignment="Center"
                          />
                        </HorizontalStackLayout>
                        <FlexLayout Grid.Row="4" Margin="0,5" Padding="5,0" Wrap="Wrap">
                          <CollectionView ItemsSource="{Binding Book.Genres}">
                            <CollectionView.ItemsLayout>
                              <LinearItemsLayout Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                              <DataTemplate x:DataType="genres:GenreDto">
                                <Border
                                  Padding="8,2"
                                  BackgroundColor="#d9a333"
                                  StrokeShape="RoundRectangle 50"
                                >
                                  <Label
                                    FontFamily="{DynamicResource AppFontFamily}"
                                    FontSize="12"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource Black}"
                                    HorizontalTextAlignment="Center"
                                  />
                                </Border>
                              </DataTemplate>
                            </CollectionView.ItemTemplate>
                          </CollectionView>
                        </FlexLayout>
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>

          <!-- New Releases -->
          <Label
            Margin="25,10"
            FontFamily="{DynamicResource AppFontFamily}"
            FontAttributes="Bold"
            FontSize="20"
            Text="New Releases"
          />
          <VerticalStackLayout Margin="25,0">
            <CollectionView
              ItemsSource="{Binding NewReleases}"
              ItemSizingStrategy="MeasureFirstItem"
            >
              <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" />
              </CollectionView.ItemsLayout>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BookWithReviewDto">
                  <Grid>
                    <Grid.GestureRecognizers>
                      <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExplorePageViewModel}}, Path=GoToBookDetailCommand}"
                        CommandParameter="{Binding Book.Id}"
                      />
                    </Grid.GestureRecognizers>
                    <Border Margin="5,0" WidthRequest="170">
                      <Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
                        <Image
                          Grid.Row="0"
                          Margin="0,0,0,10"
                          Aspect="AspectFit"
                          HeightRequest="150"
                          Source="{Binding Book.ImageUrl}"
                        />
                        <Label
                          Grid.Row="1"
                          Padding="5,0"
                          FontFamily="{DynamicResource AppFontFamily}"
                          FontSize="16"
                          LineBreakMode="WordWrap"
                          Text="{Binding Book.Title}"
                          VerticalTextAlignment="Center"
                        />
                        <Label
                          Grid.Row="2"
                          Padding="5,5"
                          FontFamily="Outfit"
                          Text="{Binding Book.Authors, Converter={StaticResource BookAuthorsConverter}}"
                          VerticalTextAlignment="Center"
                        />
                        <HorizontalStackLayout
                          Grid.Row="3"
                          Padding="5,0"
                          Spacing="5"
                          VerticalOptions="Center"
                        >
                          <mi:MauiIcon
                            Icon="{mi:FontAwesomeSolid Icon=Star}"
                            Scale=".5"
                            Style="{StaticResource Icon}"
                            IconColor="{StaticResource Gold}"
                          />
                          <Label
                            HorizontalTextAlignment="Center"
                            Text="{Binding AverageRating}"
                            VerticalTextAlignment="Center"
                          />
                        </HorizontalStackLayout>
                        <FlexLayout Grid.Row="4" Margin="0,5" Padding="5,0" Wrap="Wrap">
                          <CollectionView ItemsSource="{Binding Book.Genres}">
                            <CollectionView.ItemsLayout>
                              <LinearItemsLayout Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                              <DataTemplate x:DataType="genres:GenreDto">
                                <Border
                                  Padding="8,2"
                                  BackgroundColor="#d9a333"
                                  StrokeShape="RoundRectangle 50"
                                >
                                  <Label
                                    FontFamily="{DynamicResource AppFontFamily}"
                                    FontSize="12"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource Black}"
                                    HorizontalTextAlignment="Center"
                                  />
                                </Border>
                              </DataTemplate>
                            </CollectionView.ItemTemplate>
                          </CollectionView>
                        </FlexLayout>
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>

          <!-- For You -->
          <Label
            Margin="25,10"
            FontFamily="{DynamicResource AppFontFamily}"
            FontSize="20"
            Text="For You"
            FontAttributes="Bold"
          />
          <VerticalStackLayout Margin="25,0">
            <CollectionView
              ItemsSource="{Binding ForYouBooks}"
              ItemSizingStrategy="MeasureFirstItem"
            >
              <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" />
              </CollectionView.ItemsLayout>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BookWithReviewDto">
                  <Grid>
                    <Grid.GestureRecognizers>
                      <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExplorePageViewModel}}, Path=GoToBookDetailCommand}"
                        CommandParameter="{Binding Book.Id}"
                      />
                    </Grid.GestureRecognizers>
                    <Border Margin="5,0" WidthRequest="170">
                      <Grid RowDefinitions="*,Auto,Auto,Auto,Auto">
                        <Image
                          Grid.Row="0"
                          Margin="0,0,0,10"
                          Aspect="AspectFit"
                          HeightRequest="150"
                          Source="{Binding Book.ImageUrl}"
                        />
                        <Label
                          Grid.Row="1"
                          Padding="5,0"
                          FontFamily="{DynamicResource AppFontFamily}"
                          FontSize="16"
                          LineBreakMode="WordWrap"
                          Text="{Binding Book.Title}"
                          VerticalTextAlignment="Center"
                        />
                        <Label
                          Grid.Row="2"
                          Padding="5,5"
                          FontFamily="Outfit"
                          Text="{Binding Book.Authors, Converter={StaticResource BookAuthorsConverter}}"
                          VerticalTextAlignment="Center"
                        />
                        <HorizontalStackLayout
                          Grid.Row="3"
                          Padding="5,0"
                          Spacing="5"
                          VerticalOptions="Center"
                        >
                          <mi:MauiIcon
                            Icon="{mi:FontAwesomeSolid Icon=Star}"
                            Scale=".5"
                            Style="{StaticResource Icon}"
                            IconColor="{StaticResource Gold}"
                          />
                          <Label
                            HorizontalTextAlignment="Center"
                            Text="{Binding AverageRating}"
                            VerticalTextAlignment="Center"
                          />
                        </HorizontalStackLayout>
                        <FlexLayout Grid.Row="4" Margin="0,5" Padding="5,0" Wrap="Wrap">
                          <CollectionView ItemsSource="{Binding Book.Genres}">
                            <CollectionView.ItemsLayout>
                              <LinearItemsLayout Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                              <DataTemplate x:DataType="genres:GenreDto">
                                <Border
                                  Padding="8,2"
                                  BackgroundColor="#d9a333"
                                  StrokeShape="RoundRectangle 50"
                                >
                                  <Label
                                    FontFamily="{DynamicResource AppFontFamily}"
                                    FontSize="12"
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource Black}"
                                    HorizontalTextAlignment="Center"
                                  />
                                </Border>
                              </DataTemplate>
                            </CollectionView.ItemTemplate>
                          </CollectionView>
                        </FlexLayout>
                      </Grid>
                    </Border>
                  </Grid>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>
        </VerticalStackLayout>
      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentPage>
