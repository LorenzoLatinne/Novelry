<?xml version="1.0" encoding="UTF-8" ?>
<Application
  x:Class="NovelryMAUIApp.App"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:local="clr-namespace:NovelryMAUIApp"
  xmlns:converters="clr-namespace:NovelryMAUIApp.Converters"
  xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
>
  <Application.Resources>
    <ResourceDictionary>
      <converters:ActiveReadStatusToColorConverter x:Key="ActiveReadStatusToColorConverter" />
      <converters:BookAuthorsConverter x:Key="BookAuthorsConverter" />
      <converters:BookTitleAndAuthorConverter x:Key="BookTitleAndAuthorConverter" />
      <converters:BoolToStarColorConverter x:Key="BoolToStarColorConverter" />
      <converters:DateTimeToDateConverter x:Key="DateTimeToDateConverter" />
      <converters:RatingToStarsConverter x:Key="RatingToStarsConverter" />
      <converters:ReviewDateTimeToDateConverter x:Key="ReviewDateTimeToDateConverter" />
      <converters:ReadingStatusToColorConverter x:Key="ReadingStatusToColorConverter" />
      <converters:StatusToStringConverter x:Key="StatusToStringConverter" />
      <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
      <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
        <ResourceDictionary Source="Resources/Styles/MyStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
